# 仅为无凭据模板；推荐运行 python create_env.py 自动生成随机 SECRET_KEY。
BOT_TOKEN=

# 媒体工具。留空时自动探测：Windows 优先使用 ./ffmpeg/bin，Linux 优先使用 PATH。
FFMPEG_PATH=
FFPROBE_PATH=

# 本机音乐API配置
MUSIC_API_BASE=http://localhost:3000
QQ_MUSIC_API_BASE=http://localhost:3200
QQ_COOKIE_PATH=./Cookie/qq_cookie.txt
QQ_CREDENTIAL_PATH=./Cookie/qq_credential.json

# QQ音乐登录态自动续期（秒）
# 每3小时检查一次；正常情况下约18小时主动轮换一次，距离过期24小时内也会提前刷新。
QQ_CREDENTIAL_CHECK_INTERVAL=10800
QQ_CREDENTIAL_REFRESH_INTERVAL=64800
QQ_CREDENTIAL_REFRESH_WINDOW=86400

BILI_COOKIE_PATH=./Cookie/bili_cookie.txt

# 权限白名单 — 留空表示不启用该维度过滤
ALLOWGROUP=
ALLOWCHANNEL=
ALLOWUSER=

# /cmd 强权限名单 — 留空表示无人可执行
CMD_ALLOWUSER=

# Web控制台配置；手动复制模板时必须填写随机长字符串
SECRET_KEY=
HOST=0.0.0.0
PORT=5000
DEBUG=False
