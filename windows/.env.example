# 仅为无凭据模板；推荐运行 python create_env.py 自动生成随机 SECRET_KEY。
BOT_TOKEN=

# 媒体工具。留空时自动探测：Windows 优先使用 ./ffmpeg/bin，Linux 优先使用 PATH。
FFMPEG_PATH=
FFPROBE_PATH=

# 本机音乐API配置
MUSIC_API_BASE=http://localhost:3000
QQ_MUSIC_API_BASE=http://localhost:3200
QQ_COOKIE_PATH=./Cookie/qq_cookie.txt
BILI_COOKIE_PATH=./Cookie/bili_cookie.txt

# 权限白名单 — 留空表示不启用该维度过滤
ALLOWGROUP=
ALLOWCHANNEL=
ALLOWUSER=

# /cmd 强权限名单 — 留空表示无人可执行
CMD_ALLOWUSER=

# Web控制台配置；手动复制模板时必须填写随机长字符串
SECRET_KEY=
HOST=0.0.0.0
PORT=5000
DEBUG=False
