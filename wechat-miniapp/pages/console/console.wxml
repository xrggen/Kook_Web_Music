<view class="music-shell theme-{{resolvedTheme}} {{compact ? 'density-compact' : ''}} {{reducedMotion ? 'reduced-motion' : ''}} {{keyboardOpen ? 'keyboard-open' : ''}}" style="height:{{windowHeight}}px;font-size:{{uiFont}}px;">
  <view class="mobile-app-header" style="padding-top:{{headerTop + 6}}px;padding-right:{{headerRight}}px;">
    <button class="icon-button header-back" bindtap="back" aria-label="返回工具库"><text class="chevron-left">‹</text></button>
    <view class="brand-mark" aria-hidden="true"><view/><view/><view/><view/><view/></view>
    <view class="mobile-brand-copy"><text class="eyebrow">{{phase !== 'console' ? 'kook 机器人' : tab === 'play' ? (hasTarget ? '当前播放目标' : '选择播放目标') : 'kook 机器人'}}</text>
      <text class="kook-title">{{phase !== 'console' ? 'kook 机器人控制台' : tab === 'play' ? (hasTarget ? targetLabel : '播放') : tab === 'library' ? '音乐库' : tab === 'account' ? '音乐账号' : tab === 'status' ? '系统状态' : tab === 'users' ? '用户管理' : tab === 'settings' ? '设置' : '使用指南'}}</text></view>
  </view>

  <scroll-view wx:if="{{phase !== 'console'}}" scroll-y class="auth-scroll">
    <view class="auth-shell"><view class="auth-card">
      <view class="auth-brand"><view class="brand-mark" aria-hidden="true"><view/><view/><view/><view/><view/></view><view><text class="eyebrow">{{phase === 'password' ? 'ACCOUNT SECURITY' : 'kook 机器人'}}</text><text class="auth-brand-title">{{phase === 'password' ? user.username : 'kook 机器人控制台'}}</text></view></view>
      <text class="auth-title">{{phase === 'login' ? '登录控制台' : user.must_change_password ? '首次登录：修改密码' : '修改密码'}}</text>
      <view wx:if="{{phase === 'login' && temporaryPassword}}" class="temporary-card"><text class="track-title">{{temporaryPasswordUser}} 的临时密码</text><text class="temporary-password" selectable>{{temporaryPassword}}</text><text class="muted small-copy">仅本次显示，请记录后重新登录并修改密码。</text><button class="subtle-button full-button" bindtap="dismissTemporary">已记录，关闭</button></view>
      <text class="muted auth-copy">{{phase === 'login' ? '使用管理员创建的账号，管理 kook 机器人。' : user.must_change_password ? '设置自己的密码后，即可继续进入控制台。' : '修改后会注销该账号的其他会话，并为当前小程序建立新会话。'}}</text>
      <view wx:if="{{phase === 'login'}}" class="auth-form">
        <text class="field-label">用户名</text><input class="field-input" value="{{username}}" maxlength="32" placeholder="输入用户名" bindinput="setUsername" disabled="{{busy}}" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/>
        <text class="field-label">密码</text><input class="field-input" value="{{passwordInput}}" password maxlength="512" placeholder="输入密码" data-field="login" bindinput="setPassword" disabled="{{busy}}" confirm-type="done" bindconfirm="login" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/>
        <button class="primary-button kook-primary full-button" bindtap="login" loading="{{busy && authAction === 'password'}}" disabled="{{busy}}">登录</button>
        <button class="subtle-button full-button" bindtap="loginWithWechat" loading="{{busy && authAction === 'wechat'}}" disabled="{{busy}}">微信免密登录</button>
      </view>
      <view wx:else class="auth-form">
        <text class="field-label">当前密码</text><input class="field-input" value="{{passwordInput}}" password maxlength="512" data-field="current" placeholder="当前密码" bindinput="setPassword" disabled="{{busy}}" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/>
        <text class="field-label">新密码</text><input class="field-input" value="{{passwordInput}}" password maxlength="128" data-field="next" placeholder="8–128位，含大小写和特殊字符" bindinput="setPassword" disabled="{{busy}}" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/>
        <text class="field-label">确认新密码</text><input class="field-input" value="{{passwordInput}}" password maxlength="128" data-field="confirm" placeholder="再次输入新密码" bindinput="setPassword" disabled="{{busy}}" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/>
        <button class="primary-button full-button" bindtap="changePassword" loading="{{busy}}" disabled="{{busy}}">保存新密码</button>
        <button wx:if="{{!user.must_change_password}}" class="subtle-button full-button" bindtap="cancelSecurity" disabled="{{busy}}">返回控制台</button>
        <button class="text-button" bindtap="logout" disabled="{{busy}}">退出登录</button>
      </view>
      <text class="auth-note muted">{{phase === 'login' ? '只记住用户名。首次登录需要修改临时密码。' : '密码需8–128位，包含大写、小写字母和特殊字符；数字可选。'}}</text>
    </view></view>
  </scroll-view>

  <block wx:else>
    <scroll-view scroll-y="{{!sheet}}" class="main-scroll">
      <view class="app-stage {{tab === 'play' && hasTarget ? 'with-player' : ''}}">
        <block wx:if="{{tab === 'play'}}">
          <view class="context-cluster">
            <button class="context-selector" data-sheet="guilds" bindtap="openSheet" disabled="{{busy}}"><view class="context-icon"><image class="ui-icon" src="../../assets/ui/{{resolvedTheme}}/accent/server.png" mode="aspectFit" aria-hidden="true"/></view><view class="context-copy"><text class="eyebrow">服务器</text><text class="context-name">{{guildName}}</text></view><text class="chevron">⌄</text></button>
            <view wx:if="{{guildIndex}}" class="channel-context"><button class="channel-selector" data-sheet="channels" bindtap="openSheet" disabled="{{busy}}"><image class="ui-icon" src="../../assets/ui/{{resolvedTheme}}/accent/channel.png" mode="aspectFit" aria-hidden="true"/><text>{{channelName}}</text><text class="chevron">⌄</text></button>
              <button class="icon-button primary-button" data-action="join" bindtap="action" disabled="{{busy || !hasTarget || connected}}" aria-label="加入频道"><text>＋</text></button><button class="icon-button danger-button" data-action="leave" bindtap="action" disabled="{{busy || !hasTarget || !connected}}" aria-label="离开频道"><text>−</text></button></view>
          </view>
          <view wx:if="{{!hasTarget}}" class="dashboard-empty-state"><view class="empty-state-icon">♬</view><text class="eyebrow">kook 机器人</text><text class="empty-title">选择一个语音频道开始播放</text><text class="muted empty-copy">从顶部选择 kook 服务器与语音频道。每个频道拥有独立的播放队列与播放状态。</text><text class="target-tip">↑ 从顶部选择播放目标</text></view>
          <block wx:else>
            <view class="music-search-panel surface-panel">
              <view class="section-heading"><view class="heading-copy"><text class="eyebrow">PLAY MUSIC</text><text class="section-title">搜索并添加音乐</text><text class="muted small-copy">{{channelName}} · {{stateLabel}}</text></view><button class="subtle-button import-button" data-sheet="import" bindtap="openSheet" disabled="{{busy}}">↓ 导入歌单</button></view>
              <view class="search-box"><text class="search-symbol">⌕</text><input value="{{keyword}}" maxlength="128" placeholder="歌曲、歌手、专辑或 BV 号…" bindinput="setKeyword" bindconfirm="search" confirm-type="search" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><button class="icon-button primary-button" bindtap="search" loading="{{busy}}" disabled="{{busy}}" aria-label="搜索音乐">→</button></view>
              <view class="platform-selector"><button wx:for="{{platforms}}" wx:key="id" class="platform-option {{platform === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="choosePlatform" disabled="{{busy}}"><text class="platform-dot {{item.tone}}">{{item.symbol}}</text><text>{{item.name}}</text></button></view>
            </view>
            <view wx:if="{{searchDone || songCount}}" class="results-panel surface-panel"><view class="section-heading"><view><text class="eyebrow">SEARCH RESULTS</text><text class="section-title">搜索结果</text></view><text class="muted">{{songCount}} 首</text></view>
              <view wx:if="{{!songCount}}" class="list-empty muted">没有找到歌曲，试试其他关键词或平台。</view>
              <view wx:for="{{songs}}" wx:key="id" class="track-row"><view class="track-art {{platforms[platform].tone}}">{{platforms[platform].symbol}}</view><view class="track-copy"><text class="track-title">{{item.name}}</text><text class="muted track-subtitle">{{item.artist}}</text><text wx:if="{{item.album}}" class="muted track-album">{{item.album}}</text></view><button class="icon-button add-track-button" data-row="{{index}}" bindtap="addSong" disabled="{{busy}}" aria-label="添加{{item.name}}到队列">＋</button></view>
            </view>
          </block>
        </block>

        <block wx:elif="{{tab === 'library'}}">
          <view class="page-heading"><view><text class="eyebrow">YOUR MUSIC</text><text class="page-title">音乐库</text><text class="muted page-copy">网易云、QQ 音乐与 Bilibili 收藏夹，一个入口。</text></view><button class="icon-button" bindtap="refreshLibrary" loading="{{busy}}" disabled="{{busy}}" aria-label="刷新音乐库">↻</button></view>
          <view class="library-platform-grid"><view wx:for="{{libraryPlatforms}}" wx:key="id" class="library-platform-card"><text class="platform-dot {{item.tone}}">{{item.symbol}}</text><view class="heading-copy"><text class="track-title">{{item.accountName}}</text><text class="muted small-copy">{{item.fullName}}</text><text wx:if="{{item.error}}" class="error-copy">{{item.error}}</text></view><text class="status-pill {{item.connected ? 'ok' : ''}}">{{item.label}}</text></view></view>
          <view class="surface-panel library-panel"><view class="section-heading"><view><text class="eyebrow">COLLECTIONS</text><text class="section-title">歌单与收藏夹</text></view><button wx:if="{{user.role === 'admin'}}" class="subtle-button" data-tab="account" bindtap="chooseTab" disabled="{{busy}}">管理账号</button></view><text class="muted small-copy">{{librarySummary}}</text>
            <scroll-view scroll-x class="horizontal-options"><view class="library-filter"><button wx:for="{{['all','wy','qq','bili']}}" wx:key="*this" class="chip {{libraryFilter === item ? 'selected' : ''}}" data-platform="{{item}}" bindtap="chooseLibraryFilter">{{item === 'all' ? '全部' : item === 'wy' ? '网易云' : item === 'qq' ? 'QQ 音乐' : 'Bilibili'}}</button></view></scroll-view>
            <text class="muted small-copy collection-count">{{libraryCount}} 个收藏</text>
            <view wx:if="{{!libraryCount}}" class="library-empty"><text class="empty-state-icon">♫</text><text class="empty-title">{{busy ? '正在读取音乐库' : '音乐库为空'}}</text><text class="muted empty-copy">{{busy ? '同时检查三个平台的连接状态与歌单。' : user.role === 'admin' ? '连接音乐账号后，歌单和收藏夹会汇总到这里。' : '请联系管理员连接音乐平台，或调整当前筛选。'}}</text></view>
            <view wx:else class="library-grid"><view wx:for="{{libraryRows}}" wx:key="key" class="library-card"><view class="library-cover {{item.tone}}"><text>{{item.symbol}}</text><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" data-key="{{item.key}}" binderror="coverError" lazy-load/></view><view class="library-card-body"><text class="library-card-title">{{item.name}}</text><text class="muted small-copy">{{item.platformName}} · {{item.count}}{{item.unit}}</text><view class="library-card-actions"><button class="primary-button" data-key="{{item.key}}" bindtap="libraryIntent" disabled="{{busy}}">带到播放页</button><button class="subtle-button" data-key="{{item.key}}" bindtap="copySource" aria-label="复制歌单来源">↗</button></view></view></view></view>
          </view>
        </block>

        <block wx:elif="{{tab === 'account' && user.role === 'admin'}}">
          <view class="page-heading"><view><text class="eyebrow">MUSIC ACCOUNTS</text><text class="page-title">音乐账号</text><text class="muted page-copy">管理服务端的音乐平台登录状态。</text></view><button class="icon-button" bindtap="refreshAccount" loading="{{busy}}" disabled="{{busy}}" aria-label="刷新音乐账号">↻</button></view>
          <view class="platform-selector account-platform-switch"><button wx:for="{{platforms}}" wx:key="id" class="platform-option {{accountPlatform === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="chooseAccountPlatform" disabled="{{busy}}"><text class="platform-dot {{item.tone}}">{{item.symbol}}</text>{{item.name}}</button></view>
          <view wx:if="{{accountState !== 'ready'}}" class="surface-panel"><text class="section-title">{{accountState === 'error' ? '音乐账号状态暂未确认' : '正在读取音乐账号状态'}}</text><text class="muted page-copy">{{accountState === 'error' ? accountError : '请稍候，正在检查服务端的音乐平台登录状态。'}}</text><text wx:if="{{accountState === 'error'}}" class="muted small-copy">读取失败不代表账号已退出，请刷新后确认。</text><button wx:if="{{accountState === 'error'}}" class="subtle-button full-button" bindtap="refreshAccount" disabled="{{busy}}">重新读取状态</button></view>
          <view wx:if="{{account && account.connected}}" class="surface-panel account-profile"><view class="profile-avatar {{platforms[accountPlatform].tone}}"><text>{{platforms[accountPlatform].symbol}}</text><image wx:if="{{account.avatar}}" src="{{account.avatar}}" mode="aspectFill"/></view><text class="section-title">{{account.accountName}}</text><text class="status-pill {{accountState === 'ready' ? 'ok' : ''}}">{{accountState === 'ready' ? '已连接' : '上次确认已连接'}}</text><text wx:if="{{accountDetailsError}}" class="muted page-copy">{{accountDetailsError}}</text><view class="metric-grid account-stats"><view wx:for="{{account.stats}}" wx:key="label"><text class="metric-value">{{item.value}}</text><text class="muted small-copy">{{item.label}}</text></view></view>
            <view wx:if="{{accountState === 'ready'}}" class="row-actions"><button wx:if="{{accountPlatform === 0}}" class="primary-button" data-action="signin" bindtap="accountAction" disabled="{{busy}}">每日签到</button><button wx:if="{{accountPlatform === 1}}" class="primary-button" data-action="refresh" bindtap="accountAction" disabled="{{busy}}">续期登录</button><button class="danger-button" data-action="logout" bindtap="accountAction" disabled="{{busy}}">退出音乐账号</button></view>
          </view>
          <view wx:if="{{accountState === 'ready'}}" class="surface-panel account-login-panel"><view class="section-heading"><view><text class="eyebrow">CONNECT PLATFORM</text><text class="section-title">{{account && account.connected ? '更新登录状态' : '连接音乐账号'}}</text></view></view>
            <view class="segmented-options"><button wx:for="{{['qr','cookie','phone']}}" wx:key="*this" wx:if="{{item !== 'phone' || accountPlatform === 0}}" class="chip {{accountMode === item ? 'selected' : ''}}" data-mode="{{item}}" bindtap="chooseAccountMode" disabled="{{busy}}">{{item === 'qr' ? '扫码登录' : item === 'cookie' ? '手动 Cookie' : '手机验证码'}}</button></view>
            <view wx:if="{{accountMode === 'qr'}}" class="qr-stage"><view class="qr-image-box"><image wx:if="{{accountQr}}" class="qr-image" src="{{accountQr}}" mode="aspectFit"/><text wx:else class="muted">生成二维码后，用对应平台扫码</text></view><text class="muted qr-status">{{qrStatus || '二维码将在本次页面中显示'}}</text><button class="primary-button full-button" bindtap="createQr" disabled="{{busy}}" loading="{{busy}}">{{accountQr ? '刷新二维码' : '生成二维码'}}</button></view>
            <block wx:else><block wx:for="{{[accountInputNonce]}}" wx:key="*this" wx:for-item="nonce"><view wx:if="{{accountMode === 'cookie'}}" class="account-form"><text class="field-label">{{platforms[accountPlatform].name}} Cookie</text><textarea class="field-textarea" value="" maxlength="16384" placeholder="粘贴音乐平台 Cookie" data-field="cookie" bindinput="setAccountSecret" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><button class="primary-button full-button" data-action="cookie" bindtap="accountAction" disabled="{{busy}}">保存到音乐服务</button><text class="muted small-copy">仅发送给当前音乐服务，本机不保存 Cookie。</text></view>
              <view wx:else class="account-form"><text class="field-label">手机号</text><input class="field-input" value="" type="number" maxlength="15" placeholder="手机号" data-field="phone" bindinput="setAccountSecret" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><text class="field-label">国家／地区码</text><input class="field-input" value="" type="number" maxlength="6" placeholder="86" data-field="countrycode" bindinput="setAccountSecret"/><button class="subtle-button full-button" data-action="captcha" bindtap="accountAction" disabled="{{busy}}">发送验证码</button><text class="field-label">验证码</text><input class="field-input" value="" type="number" maxlength="8" placeholder="输入验证码" data-field="captcha" bindinput="setAccountSecret" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><button class="primary-button full-button" data-action="cellphone" bindtap="accountAction" disabled="{{busy}}">登录网易云</button></view>
            </block></block>
          </view>
        </block>

        <block wx:elif="{{tab === 'status' && user.role === 'admin'}}">
          <view class="page-heading"><view><text class="eyebrow">RUNTIME HEALTH</text><text class="page-title">系统状态</text><text class="muted page-copy">Bot、Gateway、媒体依赖与运行信息。</text></view><button class="icon-button" bindtap="refreshRuntime" loading="{{busy}}" disabled="{{busy}}" aria-label="刷新系统状态">↻</button></view>
          <view class="surface-panel health-hero"><view class="health-orb {{runtime ? runtime.tone : ''}}">●</view><view class="heading-copy"><text class="section-title">{{runtime ? runtime.title : busy ? '正在读取运行状态' : '尚未读取运行状态'}}</text><text class="muted page-copy">{{runtime ? runtime.copy : '点击刷新获取音乐执行节点的健康状态。'}}</text><text wx:if="{{runtime}}" class="muted small-copy">最近刷新 {{runtime.refreshedAt}}</text></view></view>
          <view wx:if="{{runtime}}" class="metric-grid health-metric-grid"><view wx:for="{{runtime.metrics}}" wx:key="label" class="surface-panel metric-card"><text class="muted small-copy">{{item.label}}</text><text class="metric-value">{{item.value}}</text></view></view>
          <view wx:if="{{runtime}}" class="surface-panel"><text class="section-title">运行检查</text><view wx:for="{{runtime.rows}}" wx:key="label" class="status-row"><text>{{item.label}}</text><text class="status-pill">{{item.value}}</text></view><view wx:for="{{systemMetrics}}" wx:key="label" class="status-row"><text>{{item.label}}</text><text class="muted">{{item.value}}</text></view></view>
          <view class="surface-panel"><view class="section-heading"><text class="section-title">运行日志</text><button class="icon-button" bindtap="refreshLogs" disabled="{{busy}}" aria-label="读取日志">↻</button></view><text class="muted small-copy">最近200条音乐服务运行日志</text><text wx:if="{{!logCount}}" class="muted list-empty">{{logsLoaded ? '当前日志为空' : '点击刷新读取日志'}}</text><view wx:for="{{logs}}" wx:key="id" class="log-row log-{{item.level}}"><text class="muted small-copy">{{item.timestamp}} · {{item.level}}</text><text selectable>{{item.message}}</text></view><button class="danger-button full-button" bindtap="clearLogs" disabled="{{busy}}">清空当前服务端日志</button></view>
        </block>

        <block wx:elif="{{tab === 'users' && user.role === 'admin'}}">
          <view class="page-heading"><view><text class="eyebrow">ACCESS CONTROL</text><text class="page-title">用户管理</text><text class="muted page-copy">管理角色、启用状态与播放范围。</text></view><button class="icon-button" bindtap="refreshUsers" loading="{{busy}}" disabled="{{busy}}" aria-label="刷新用户">↻</button></view>
          <view wx:if="{{temporaryPassword}}" class="temporary-card"><text class="section-title">{{temporaryPasswordUser}} 的临时密码</text><text class="temporary-password" selectable>{{temporaryPassword}}</text><text class="muted small-copy">仅本次显示，请交给本人修改。离开页面后隐藏。</text><button class="subtle-button full-button" bindtap="dismissTemporary">已记录，关闭</button></view>
          <view class="surface-panel"><text class="section-title">创建用户</text><text class="field-label">用户名</text><input class="field-input" value="{{createUsername}}" maxlength="32" data-field="createUsername" bindinput="setCreateField" placeholder="用户名" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><text class="field-label">角色</text><picker range="{{roles}}" value="{{createRole}}" bindchange="chooseCreateRole" disabled="{{busy}}"><view class="field-picker">{{roles[createRole]}} ⌄</view></picker><text wx:if="{{createRole === 0}}" class="field-label">播放范围</text><input wx:if="{{createRole === 0}}" class="field-input" value="{{createScopes}}" maxlength="4096" data-field="createScopes" bindinput="setCreateField" placeholder="* 或 guild:ID、channel:服务器ID/频道ID" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><button class="primary-button full-button" bindtap="createUser" disabled="{{busy}}">创建并生成临时密码</button></view>
          <view class="surface-panel"><text class="section-title">用户列表 · {{userCount}}</text><text wx:if="{{!userCount}}" class="muted list-empty">{{busy ? '正在读取用户' : '暂无用户数据'}}</text><view wx:for="{{users}}" wx:key="id" class="iam-user-row"><view class="section-heading"><view class="heading-copy"><text class="track-title">{{item.username}}</text><text class="muted small-copy">{{item.loginLabel}}</text></view><switch checked="{{item.enabled}}" data-id="{{item.id}}" data-field="enabled" bindchange="editUser" disabled="{{busy}}" color="#6758e7" aria-label="启用{{item.username}}"/></view><picker range="{{roles}}" value="{{item.roleIndex}}" data-id="{{item.id}}" data-field="role" bindchange="editUser" disabled="{{busy}}"><view class="field-picker">{{roles[item.roleIndex]}} ⌄</view></picker><input wx:if="{{item.role === 'user'}}" class="field-input" value="{{item.scopes}}" maxlength="4096" data-id="{{item.id}}" data-field="scopes" bindinput="editUser" placeholder="播放范围" disabled="{{busy}}" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><view class="row-actions"><button class="subtle-button" data-id="{{item.id}}" data-action="save" bindtap="userAction" disabled="{{busy}}">保存</button><button class="subtle-button" data-id="{{item.id}}" data-action="reset" bindtap="userAction" disabled="{{busy}}">重置密码</button><button class="danger-button" data-id="{{item.id}}" data-action="remove" bindtap="userAction" disabled="{{busy}}">删除</button></view></view></view>
        </block>

        <block wx:elif="{{tab === 'settings' && user.role === 'admin'}}">
          <view class="page-heading"><view><text class="eyebrow">PREFERENCES</text><text class="page-title">设置</text><text class="muted page-copy">当前小程序的界面偏好。</text></view></view>
          <view class="surface-panel"><text class="section-title">界面体验</text><view class="setting-row"><text class="track-title">主题模式</text><text class="muted page-copy">默认浅色，也可固定深色或跟随系统外观。</text><view class="theme-choice-group"><button wx:for="{{['light','dark','system']}}" wx:key="*this" class="chip {{themeMode === item ? 'selected' : ''}}" data-theme="{{item}}" bindtap="chooseTheme">{{item === 'light' ? '浅色' : item === 'dark' ? '深色' : '跟随系统'}}</button></view></view><view class="setting-row setting-switch"><view class="heading-copy"><text class="track-title">紧凑布局</text><text class="muted small-copy">减少面板与列表间距。</text></view><switch checked="{{compact}}" data-field="compact" bindchange="setPreference" color="#6758e7"/></view><view class="setting-row setting-switch"><view class="heading-copy"><text class="track-title">减少动画</text><text class="muted small-copy">减少过渡和位移动效。</text></view><switch checked="{{reducedMotion}}" data-field="reducedMotion" bindchange="setPreference" color="#6758e7"/></view></view>
          <view class="surface-panel"><text class="section-title">恢复默认</text><text class="muted page-copy">恢复浅色、舒适间距和默认动画。</text><button class="subtle-button full-button" bindtap="resetPreferences">恢复默认界面设置</button></view>
        </block>

        <view wx:else class="surface-panel"><text class="eyebrow">kook 机器人</text><text class="page-title">使用指南</text><text class="muted page-copy">选择服务器与语音频道，加入后即可搜索点歌或导入歌单。每个频道有独立的播放队列。</text><text class="muted page-copy">点击底部迷你播放器可展开控制；队列弹层可刷新、设为下一首、移除歌曲或清空待播内容。</text><text class="muted page-copy">音乐库中的“带到播放页”只选择歌单，点击导入后才会执行操作。</text><text class="muted page-copy">写操作超时后先刷新确认状态，避免重复提交。</text><text class="muted page-copy">服务：{{serviceUrl}}</text><button class="subtle-button full-button" bindtap="copyServiceUrl">复制网页控制台地址</button></view>
      </view>
    </scroll-view>

    <view wx:if="{{tab === 'play' && hasTarget && !keyboardOpen}}" class="global-player"><view class="now-playing-copy" data-sheet="player" bindtap="openSheet"><view class="now-playing-art">♫</view><view class="track-copy"><text class="track-title">{{currentSong}}</text><text class="muted track-subtitle">{{currentArtist}}</text></view></view><button class="icon-button mini-play primary-button" bindtap="togglePlayback" disabled="{{busy}}" aria-label="{{isPlaying ? '暂停' : '继续播放'}}"><view class="{{isPlaying ? 'icon-pause' : 'icon-play'}}"/></button><button class="icon-button" data-action="skip" bindtap="action" disabled="{{busy}}" aria-label="下一首"><view class="icon-skip"/></button><button class="icon-button" data-sheet="queue" bindtap="openSheet" aria-label="播放队列"><view class="icon-list"/></button></view>

    <view wx:if="{{!keyboardOpen}}" class="mobile-bottom-nav">
      <button class="mobile-nav-item {{tab === 'play' ? 'active' : ''}}" data-tab="play" bindtap="chooseTab"><image class="ui-icon nav-icon" src="../../assets/ui/{{resolvedTheme}}/{{tab === 'play' ? 'accent' : 'muted'}}/play.png" mode="aspectFit" aria-hidden="true"/><text>播放</text></button>
      <button class="mobile-nav-item {{tab === 'library' ? 'active' : ''}}" data-tab="library" bindtap="chooseTab"><image class="ui-icon nav-icon" src="../../assets/ui/{{resolvedTheme}}/{{tab === 'library' ? 'accent' : 'muted'}}/music.png" mode="aspectFit" aria-hidden="true"/><text>音乐库</text></button>
      <button wx:if="{{user.role === 'admin'}}" class="mobile-nav-item {{tab === 'account' ? 'active' : ''}}" data-tab="account" bindtap="chooseTab"><image class="ui-icon nav-icon" src="../../assets/ui/{{resolvedTheme}}/{{tab === 'account' ? 'accent' : 'muted'}}/user.png" mode="aspectFit" aria-hidden="true"/><text>账号</text></button>
      <button wx:else class="mobile-nav-item" bindtap="openSecurity"><image class="ui-icon nav-icon" src="../../assets/ui/{{resolvedTheme}}/muted/user.png" mode="aspectFit" aria-hidden="true"/><text>我的</text></button>
      <button class="mobile-nav-item {{sheet === 'more' || tab === 'status' || tab === 'users' || tab === 'settings' || tab === 'help' ? 'active' : ''}}" data-tab="more" bindtap="chooseTab"><image class="ui-icon nav-icon" src="../../assets/ui/{{resolvedTheme}}/{{sheet === 'more' || tab === 'status' || tab === 'users' || tab === 'settings' || tab === 'help' ? 'accent' : 'muted'}}/more.png" mode="aspectFit" aria-hidden="true"/><text>更多</text></button>
    </view>

    <view wx:if="{{sheet}}" class="sheet-layer {{keyboardOpen ? 'sheet-keyboard' : ''}}" style="{{keyboardOpen ? 'bottom:' + keyboardHeight + 'px;' : ''}}"><view class="sheet-mask" bindtap="closeSheet" catchtouchmove="stopTouch"/>
      <view class="bottom-sheet {{sheet === 'player' ? 'expanded-player' : ''}}" role="dialog" aria-modal="true">
        <view class="sheet-handle-area" bindtouchstart="sheetTouchStart" bindtouchend="sheetTouchEnd"><view class="sheet-handle"/></view>
        <view class="sheet-heading"><view class="heading-copy"><text class="eyebrow">{{sheet === 'queue' ? 'NEXT UP' : sheet === 'player' ? channelName : sheet === 'guilds' ? 'KOOK SERVERS' : sheet === 'channels' ? guildName : sheet === 'import' ? 'IMPORT PLAYLIST' : user.role === 'admin' ? 'ADMIN' : 'USER'}}</text><text class="section-title">{{sheet === 'queue' ? '播放队列 · ' + queueCount : sheet === 'player' ? '正在播放' : sheet === 'guilds' ? '选择播放服务器' : sheet === 'channels' ? '选择语音频道' : sheet === 'import' ? '添加歌单到当前频道' : user.username}}</text></view><button class="icon-button" bindtap="closeSheet" aria-label="关闭弹层">×</button></view>
        <scroll-view scroll-y class="sheet-scroll">
          <block wx:if="{{sheet === 'guilds' || sheet === 'channels'}}"><button wx:if="{{sheet === 'guilds'}}" class="subtle-button full-button" bindtap="refreshGuilds" disabled="{{busy}}">↻ 刷新服务器</button><button wx:for="{{sheet === 'guilds' ? guilds : channels}}" wx:key="id" class="context-option {{(sheet === 'guilds' ? guildIndex : channelIndex) === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="{{sheet === 'guilds' ? 'chooseGuild' : 'chooseChannel'}}" disabled="{{busy}}"><view class="context-option-art"><image class="ui-icon" src="../../assets/ui/{{resolvedTheme}}/accent/{{sheet === 'guilds' ? 'server' : 'channel'}}.png" mode="aspectFit" aria-hidden="true"/><image wx:if="{{item.icon}}" class="context-avatar" src="{{item.icon}}" mode="aspectFill" data-kind="{{sheet}}" data-id="{{item.id}}" data-src="{{item.icon}}" binderror="contextIconError" aria-hidden="true"/></view><text class="heading-copy">{{item.name}}</text><text wx:if="{{(sheet === 'guilds' ? guildIndex : channelIndex) === index}}">✓</text></button><text wx:if="{{(sheet === 'guilds' ? guildCount : channelCount) <= 1}}" class="muted list-empty">暂无可见资源，请刷新或检查账号授权。</text></block>
          <block wx:elif="{{sheet === 'queue'}}"><view class="queue-tools"><text class="muted">接下来</text><button class="icon-button" bindtap="refreshState" disabled="{{busy}}" aria-label="刷新队列">↻</button><button class="icon-button danger-button" data-action="clear" bindtap="action" disabled="{{busy || !queueCount}}" aria-label="清空队列">×</button></view><view wx:if="{{!queueCount}}" class="list-empty muted">{{currentSong === '未播放' ? '播放列表为空' : '当前歌曲之后暂无待播内容'}}</view><view wx:for="{{queue}}" wx:key="key" class="queue-row"><text class="queue-number">{{item.number}}</text><view class="track-copy"><text class="track-title">{{item.name}}</text><text class="muted track-subtitle">{{item.artist}}</text></view><button class="icon-button" data-row="{{index}}" data-action="promote" bindtap="queueAction" disabled="{{busy || item.queueIndex === null}}" aria-label="设{{item.name}}为下一首">↑</button><button class="icon-button danger-button" data-row="{{index}}" data-action="remove" bindtap="queueAction" disabled="{{busy || item.queueIndex === null}}" aria-label="移除{{item.name}}">×</button></view><text class="muted queue-footnote">当前版本按加入顺序播放</text></block>
          <view wx:elif="{{sheet === 'player'}}" class="expanded-player-content"><view class="expanded-artwork" bindtouchstart="sheetTouchStart" bindtouchend="sheetTouchEnd">♫</view><view class="expanded-track-copy"><text class="expanded-song">{{currentSong}}</text><text class="muted page-copy">{{currentArtist}}</text><text class="muted small-copy">频道：{{channelName}} · {{stateLabel}}</text></view><view class="expanded-controls"><button class="icon-button {{repeat ? 'selected' : ''}}" data-action="repeat" bindtap="action" disabled="{{busy}}" aria-label="{{repeat ? '关闭列表循环' : '开启列表循环'}}">↻</button><button class="icon-button main-play-button primary-button" bindtap="togglePlayback" disabled="{{busy}}" aria-label="{{isPlaying ? '暂停' : '继续播放'}}"><view class="{{isPlaying ? 'icon-pause' : 'icon-play'}}"/></button><button class="icon-button" data-action="skip" bindtap="action" disabled="{{busy}}" aria-label="下一首"><view class="icon-skip"/></button></view><view class="player-progress"><text>{{positionText}}</text><view class="progress-track"><view style="width:{{progressPercent}}%;"/></view><text>{{durationText}}</text></view><view class="expanded-secondary"><button class="subtle-button" data-sheet="queue" bindtap="openSheet">播放队列 · {{queueCount}}</button><button class="danger-button" data-action="stop" bindtap="action" disabled="{{busy}}">停止播放</button></view><text class="muted small-copy">{{repeat ? '列表循环已开启' : '按队列顺序播放'}}</text></view>
          <view wx:elif="{{sheet === 'import'}}" class="import-form"><text class="muted page-copy">导入到 {{channelName}}</text><text wx:if="{{importName}}" class="track-title">{{importName}}</text><view class="platform-selector"><button wx:for="{{platforms}}" wx:key="id" class="platform-option {{platform === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="choosePlatform" disabled="{{busy}}">{{item.name}}</button></view><text class="field-label">歌单 ID 或链接</text><input class="field-input" value="{{playlistId}}" maxlength="1024" placeholder="网易云、QQ歌单或B站收藏夹链接" bindinput="setPlaylist" bindfocus="keyboardFocus" bindblur="keyboardBlur" bindkeyboardheightchange="keyboardHeight" adjust-position/><button class="primary-button full-button" bindtap="importPlaylist" loading="{{busy}}" disabled="{{busy}}">导入到播放队列</button></view>
          <view wx:elif="{{sheet === 'wechat'}}" class="wechat-binding">
            <text class="section-title">微信绑定</text>
            <text class="muted page-copy">{{wechatBound === null ? (authAction === 'binding' ? '正在处理微信绑定…' : busy ? '正在查询绑定状态…' : '暂未取得绑定状态') : wechatBound ? '当前控制台账号已绑定微信。' : '当前控制台账号尚未绑定微信。'}}</text>
            <text class="muted small-copy">绑定后，在登录页点击「微信免密登录」即可进入。绑定一对一，普通退出会保留绑定，修改或重置密码会解除绑定。</text>
            <button wx:if="{{wechatBound === false}}" class="primary-button full-button" bindtap="requestBindWechat" disabled="{{busy}}">绑定当前微信</button>
            <button wx:elif="{{wechatBound === true}}" class="danger-button full-button" bindtap="requestUnbindWechat" disabled="{{busy}}">解除微信绑定</button>
            <button wx:if="{{wechatBound === null && !busy}}" class="subtle-button full-button" bindtap="refreshWechatBinding">刷新绑定状态</button>
          </view>
          <view wx:else class="more-menu">
            <block wx:if="{{user.role === 'admin'}}">
              <button class="more-link" data-tab="status" bindtap="chooseTab"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/activity.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">系统状态</text><text class="muted small-copy">Bot、Gateway、媒体与运行信息</text></view><text>›</text></button>
              <button class="more-link" data-tab="users" bindtap="chooseTab"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/users.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">用户管理</text><text class="muted small-copy">角色、播放范围与登录状态</text></view><text>›</text></button>
              <button class="more-link" data-tab="settings" bindtap="chooseTab"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/settings.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">设置</text><text class="muted small-copy">主题、密度和动画偏好</text></view><text>›</text></button>
            </block>
            <button class="more-link" bindtap="openSecurity"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/lock.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">修改密码</text><text class="muted small-copy">更新当前控制台密码</text></view><text>›</text></button>
            <button class="more-link" bindtap="openWechatBinding" disabled="{{busy}}"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/lock.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">微信绑定</text><text class="muted small-copy">管理登录页的微信免密登录</text></view><text>›</text></button>
            <button class="more-link" data-tab="help" bindtap="chooseTab"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/help.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">使用指南</text><text class="muted small-copy">频道、播放队列与音乐库</text></view><text>›</text></button>
            <button class="more-link" bindtap="requestLogout" disabled="{{busy}}"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/logout.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">退出登录</text><text class="muted small-copy">注销当前小程序会话</text></view><text>›</text></button>
            <button class="more-link" bindtap="back"><image class="more-symbol" src="../../assets/ui/{{resolvedTheme}}/accent/arrow-left.png" mode="aspectFit" aria-hidden="true"/><view><text class="track-title">返回工具库</text><text class="muted small-copy">打开其他随身工具</text></view><text>›</text></button>
          </view>
        </scroll-view>
      </view>
    </view>
  </block>
  <view wx:if="{{error || message}}" class="notice {{error ? 'notice-error' : 'notice-success'}}" style="top:{{headerTop + 62}}px;"><text>{{error || message}}</text><button class="icon-button" bindtap="dismissNotice" aria-label="关闭提示">×</button></view>
</view>
