# Python
__pycache__/
*.py[cod]
*.bak
venv/

# Logs
*.log
*.log.*
windows/log.txt
Ubuntu/app.log
Ubuntu/debug.log

# Environment (secrets)
.env
**/.env
**/.env.*
!**/.env.example

# Keys, credentials and local session stores
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
*.session
*.session-journal
*.secret
*credentials*.json
*secrets*.json

# Web control-plane runtime databases
**/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Node
node_modules/

# IDE
.vscode/
.idea/
*.code-workspace

# Temp
*.zip
/tmp/

# FFmpeg binaries (large)
ffmpeg/
ffmpeg.exe
ffmpeg.exe.bac
ffmpeg.bac/

# Cookie files (contain secrets)
**/Cookie/*
!**/Cookie/README.md

# Runtime artifacts
.heartbeat
.bot_heartbeat
.web_heartbeat
*.pid

# Claude Code
.claude/

# OS
.DS_Store
Thumbs.db

