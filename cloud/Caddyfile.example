# Cloud 公网 Web UI 使用独立非标准 HTTPS 端口 28443。
# 访问地址：https://music.example.com:28443/
# Cloud Flask 仍只监听 127.0.0.1:18473。
#
# 使用 Caddy 自动申请/续期公网证书时，建议防火墙同时允许 TCP 80，
# 供 ACME HTTP-01 challenge 使用。443 不作为本项目正式业务入口。
https://music.example.com:28443 {
    encode zstd gzip
    reverse_proxy 127.0.0.1:18473
}

# Edge WSS 使用独立非标准端口池。所有入口收敛到同一个本地 RelayHub。
# 防火墙需放行 TCP 28470-28479；18473/18476 不应直接暴露公网。
https://music.example.com:28470 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28471 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28472 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28473 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28474 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28475 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28476 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28477 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
}
https://music.example.com:28478 {
    @edge path /edge/v1/connect
    handle @edge { reverse_proxy 127.0.0.1:18476 }
    respond 404
