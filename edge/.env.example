# Edge 本地 WebUI。默认只允许本机访问；需要局域网访问时显式改成 0.0.0.0 并配置主机防火墙。
EDGE_LOCAL_WEB_HOST=127.0.0.1
EDGE_LOCAL_PORT=18473
# EDGE_PLATFORM_DIR=windows
# EDGE_PLATFORM_DIR=Ubuntu

# 远端 Cloud bootstrap。首次启动后可在 Edge 本地 WebUI -> 设置 中修改并持久化。
EDGE_RELAY_ENABLED=true
EDGE_RELAY_HOST=music.example.com
EDGE_RELAY_PORT_START=28470
EDGE_RELAY_PORT_END=28479
EDGE_RELAY_PATH=/edge/v1/connect
EDGE_RELAY_TLS_VERIFY=true

EDGE_AGENT_ID=edge-main
EDGE_AGENT_NAME=Primary Edge
EDGE_AGENT_TOKEN=

# 旧版兼容：如果没有填写 EDGE_RELAY_HOST，则会从 EDGE_RELAY_URL 一次性迁移为结构化配置。
# EDGE_RELAY_URL=wss://music.example.com:28470/edge/v1/connect

EDGE_HEARTBEAT_INTERVAL=15
EDGE_RUNTIME_SYNC_INTERVAL=5
EDGE_TOPOLOGY_SYNC_INTERVAL=300

# Edge 动态配置与 Agent Secret 默认写入平台 data/ 目录，可按需覆盖。
# EDGE_CONFIG_DATABASE_PATH=./data/edge_config.db
# EDGE_AGENT_SECRET_PATH=./data/edge-agent.secret
LOG_LEVEL=INFO
